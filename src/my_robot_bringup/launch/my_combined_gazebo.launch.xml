<launch>
    <set_parameter name="use_sim_time" value="true"/>
    
    <let name="urdf_path"
        value="$(find-pkg-share my_robot_description)/urdf/my_combined_robot_gazebo_ros2_control.xacro"/>

    <let name="gazebo_config_path"
         value="$(find-pkg-share my_robot_bringup)/config/combined_ros2_control_gazebo_bridge.yaml" />

    <let name="rviz_config_path"
        value="$(find-pkg-share my_robot_description)/rviz/urdf_config.rviz"/>

    <let name="robot_description"
        value="$(command 'xacro $(var urdf_path)')"/>

    <node pkg="robot_state_publisher"
          exec="robot_state_publisher"
          output="screen">
        <param name="robot_description"
               value="$(var robot_description)"/>
    </node>

    <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py" >
        <arg name="gz_args" 
             value="empty.sdf -r" />
    </include> 

    <node pkg="ros_gz_sim" exec="create" args="-topic robot_description" />

    <node pkg="ros_gz_bridge" exec="parameter_bridge" >
        <param name="config_file" value="$(var gazebo_config_path)" />
    </node>

    <node pkg="controller_manager"
          exec="spawner"
          output="screen"
          args="joint_state_broadcaster --controller-manager /controller_manager"/>
    
    <node pkg="controller_manager"
        exec="spawner"
        output="screen"
        args="diff_drive_controller --controller-manager /controller_manager"/>

    <node pkg="controller_manager"
        exec="spawner"
        output="screen" 
        args="my_pid_controller --controller-manager /controller_manager"/>

    <include file="$(find-pkg-share my_combined_robot_moveit_config)/launch/move_group.launch.py"/>

    <node pkg="my_robot_commander_cpp"
          exec="pid_trajectory_adapter"
          output="screen" >
    </node>

    <node pkg="my_robot_commander_cpp"
          exec="commander_combined"
          output="screen" >
    </node>

    <node pkg="rviz2"
          exec="rviz2"
          output="screen"
          args="-d $(var rviz_config_path)"/>
    
</launch>